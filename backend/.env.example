# Server (Render sets PORT automatically)
PORT=4000
# Supabase Postgres connection string (Project Settings > Database > Connection string > URI, use the pooler URL on Render)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase API (Storage for resume files). The service role key is SECRET: backend only, never in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes
# Auth
JWT_SECRET=change-me-to-a-long-random-string
DEMO_EMAIL=hr@demo.com
DEMO_PASSWORD=demo123
# Comma-separated list of allowed frontend origins (your Vercel URL, no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOW_VERCEL_PREVIEWS=false
